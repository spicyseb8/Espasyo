// Merge into the existing Firestore ruleset. No deployable ruleset exists in this checkout.
match /notifications/{notificationId} {
  allow read, write: if false;

  match /recipients/{recipientUid} {
    allow read: if request.auth != null
      && request.auth.uid == recipientUid
      && resource.data.recipientUid == request.auth.uid;
    allow create, delete: if false;
    allow update: if request.auth != null
      && request.auth.uid == recipientUid
      && resource.data.recipientUid == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
      && request.resource.data.read is bool
      && (request.resource.data.read == false || request.resource.data.readAt == request.time);
  }
}

match /notificationCounters/{counterId} {
  allow read, write: if false;
}

match /notificationEventKeys/{eventKeyId} {
  allow read, write: if false;
}
